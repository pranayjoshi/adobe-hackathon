{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "resize",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": [
        "lite.app:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8770"
      ],
      "port": 8770,
      "autoPort": false
    },
    {
      "name": "api",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": [
        "service.app:app",
        "--port",
        "8765"
      ],
      "port": 8765,
      "autoPort": false
    },
    {
      "name": "viewer",
      "runtimeExecutable": "viewer/node_modules/.bin/vite",
      "runtimeArgs": [
        "viewer",
        "--host",
        "127.0.0.1"
      ],
      "port": 5180,
      "autoPort": false
    },
    {
      "name": "api-latest",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": [
        "service.app:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8766"
      ],
      "port": 8766,
      "autoPort": false
    },
    {
      "name": "viewer-latest",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": [
        "CHAMELEON_API=http://127.0.0.1:8766",
